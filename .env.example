# ─────────────────────────────────────────────────────────────
#  Sanctuary Core — environment configuration
#  Copy this file to `.env` and fill in the values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# Required: bot token from https://discord.com/developers/applications → Bot
DISCORD_TOKEN=

# Optional: application id (derived from the token when omitted)
DISCORD_APPLICATION_ID=

# Optional: only needed when receiving interactions over HTTP (see HTTP_PORT)
DISCORD_PUBLIC_KEY=

# Where the SQLite database lives (directory is created automatically)
DATABASE_PATH=./data/sanctuary.db

# Slash command registration: "global" (all servers) or "guild" (instant, dev only)
COMMAND_SCOPE=global
# Guild used when COMMAND_SCOPE=guild
DEV_GUILD_ID=
# Push the command list to Discord on startup when it changed (true/false)
SYNC_COMMANDS=true

# Privileged gateway intents (toggle them in the Developer Portal → Bot as well)
# MESSAGE_CONTENT lets the anti-spam engine read message text (strongly recommended)
ENABLE_MESSAGE_CONTENT=true
# GUILD_MEMBERS enables welcome cards and leaver tracking
ENABLE_GUILD_MEMBERS=true

# zlib-stream transport compression for the gateway (true/false)
GATEWAY_COMPRESSION=true

# Optional HTTP server: health check on GET /health and, if you set the
# Interactions Endpoint URL in the Developer Portal to https://<host>/interactions,
# signed HTTP interactions on POST /interactions (requires DISCORD_PUBLIC_KEY).
HTTP_PORT=
HTTP_HOST=0.0.0.0

# Logging: debug | info | warn | error ; format: pretty | json
LOG_LEVEL=info
LOG_FORMAT=pretty

# Behind an HTTP(S) proxy? Set HTTPS_PROXY and NODE_USE_ENV_PROXY=1 (Node >= 22.21)
# HTTPS_PROXY=
# NODE_USE_ENV_PROXY=1
